# ══ i3 config ══════════════════════════════════════════════════
# Keybindings mirror tmux: same motions, different layer.

set $mod Mod4
workspace_auto_back_and_forth yes
set $term alacritty

font pango:JetBrainsMono Nerd Font 10

# ─── Gaps & borders ────────────────────────────────────────────
gaps inner 8
gaps outer 0
gaps top 44
default_border pixel 2
default_floating_border pixel 2
smart_borders on

# ─── Colours: Tokyo Night ──────────────────────────────────────
set $bg      #1a1b26
set $fg      #c0caf5
set $accent  #7aa2f7
set $inact   #414868
set $urgent  #f7768e

# class                 border   backgr.  text     indicator child_border
client.focused          $accent  $accent  $bg      $accent   $accent
client.focused_inactive $inact   $inact   $fg      $inact    $inact
client.unfocused        $bg      $bg      $inact   $bg       $inact
client.urgent           $urgent  $urgent  $bg      $urgent   $urgent

# ─── Launch ────────────────────────────────────────────────────
bindsym $mod+Return exec $term
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Shift+d exec --no-startup-id rofi -show run
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+Shift+Tab exec --no-startup-id rofi -show window
bindsym Mod1+Tab focus right
bindsym Mod1+Shift+Tab focus left
bindsym $mod+Shift+q kill

# ─── Focus (same keys as tmux pane navigation) ─────────────────
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# ─── Move window ───────────────────────────────────────────────
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# ─── Resize (hold to repeat) ───────────────────────────────────
bindsym $mod+Control+h resize shrink width 5 px or 5 ppt
bindsym $mod+Control+j resize grow height 5 px or 5 ppt
bindsym $mod+Control+k resize shrink height 5 px or 5 ppt
bindsym $mod+Control+l resize grow width 5 px or 5 ppt

# ─── Split (mirrors tmux | and -) ──────────────────────────────
bindsym $mod+backslash split h
bindsym $mod+minus split v

# ─── Layout ────────────────────────────────────────────────────
bindsym $mod+f fullscreen toggle
bindsym $mod+z fullscreen toggle
bindsym $mod+e layout toggle split
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# ─── Workspaces ────────────────────────────────────────────────
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

# ─── Session ───────────────────────────────────────────────────
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id ~/.config/i3/scripts/powermenu.sh
bindsym $mod+Shift+x exec --no-startup-id ~/.config/i3/scripts/lock.sh

# ─── Media & hardware keys ─────────────────────────────────────
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym Print exec --no-startup-id "maim -s -u -k | xclip -selection clipboard -t image/png"
bindsym $mod+Shift+a exec --no-startup-id ~/.config/i3/scripts/screenshot.sh
bindsym $mod+Print exec --no-startup-id "maim -u ~/Pictures/screenshots/$(date +%Y%m%d-%H%M%S).png"

# ─── Floating rules ────────────────────────────────────────────
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Arandr"] floating enable
for_window [class="Virt-manager" title="^(?!Virtual Machine Manager).*"] floating enable

# ─── Autostart ─────────────────────────────────────────────────
exec_always --no-startup-id sh -c "pkill -x picom; sleep 0.3; exec picom"
exec --no-startup-id dunst
exec --no-startup-id blueman-applet
exec --no-startup-id /usr/libexec/polkit-mate-authentication-agent-1
exec --no-startup-id feh --bg-fill ~/.wallpaper
exec_always --no-startup-id sh -c 'pkill -x xss-lock; sleep 0.3; exec xss-lock --transfer-sleep-lock -- $HOME/.config/i3/scripts/lock.sh'

exec_always --no-startup-id ~/.config/polybar/launch.sh

# ─── Machine-local overrides (never committed) ─────────────────
include ~/.config/i3/config.local

# ─── Multi-monitor ─────────────────────────────────────────────
# Move focus between outputs
bindsym $mod+Control+Left  focus output left
bindsym $mod+Control+Right focus output right

# Move current workspace to the other output
bindsym $mod+Shift+greater move workspace to output right
bindsym $mod+Shift+less    move workspace to output left

# Re-apply saved display layout
bindsym $mod+p exec --no-startup-id ~/.screenlayout/default.sh

# ─── Notifications (dunst) ─────────────────────────────────────
bindsym $mod+n        exec --no-startup-id dunstctl close
bindsym $mod+Shift+n  exec --no-startup-id dunstctl close-all
bindsym $mod+Ctrl+n   exec --no-startup-id dunstctl history-pop
bindsym $mod+Mod1+n   exec --no-startup-id dunstctl set-paused toggle

# ─── Automatic split direction ─────────────────────────────────
exec_always --no-startup-id ~/.config/i3/scripts/touchpad.sh
exec_always --no-startup-id autotiling
exec_always --no-startup-id sh -c 'pkill -f "bash .*cava-daemon" ; pkill -x cava ; sleep 0.3 ; exec "$HOME/.config/i3/scripts/cava-daemon.sh"'

# ─── GTK theme for Chrome, virt-manager, file dialogs ──────────
exec_always --no-startup-id gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3-blue-dark"
exec_always --no-startup-id gsettings set org.gnome.desktop.interface icon-theme "Papirus-Dark"
exec_always --no-startup-id gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"

# ─── Rofi tools ────────────────────────────────────────────────
bindsym $mod+F1 exec --no-startup-id ~/.config/i3/scripts/cheatsheet.sh
bindsym $mod+Shift+w exec --no-startup-id ~/.config/i3/scripts/network.sh
bindsym $mod+Shift+b exec --no-startup-id ~/.config/i3/scripts/bluetooth.sh
bindsym $mod+Shift+i exec --no-startup-id ~/.config/i3/scripts/caffeine.sh toggle

# ─── Power menu ────────────────────────────────────────────────
